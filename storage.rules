rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Family = the logins listed in the app's config/main "members" map
    // (each login is added there when its owner picks who they are in the app).
    // When publishing, allow Storage rules to read Firestore ("Grant access").
    function isFamily() {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/config/main).data.members;
    }
    match /files/{fileId}/{name} {
      allow read, delete: if isFamily();
      // PDFs and pictures only, up to 30 MB
      allow create: if isFamily()
        && request.resource.size < 30 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }
  }
}
